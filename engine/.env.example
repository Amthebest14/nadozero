# Copy to .env.local and fill in locally. Never commit it — it holds a key.
# CopyModal's "Download" button generates a file in exactly this shape.

# The leader wallet to watch (read-only, no key needed for this one).
LEADER=

# Whose subaccount orders land in — the follower's own wallet address.
FOLLOWER_WALLET_ADDRESS=

# The follower's dedicated signer private key. Generate it yourself with
# `npm run generate-signer`, or it's produced automatically by CopyModal —
# never paste an existing wallet's key here, and never share this value.
FOLLOWER_SIGNER_PRIVATE_KEY=

# proportional | fixed — see sizing.ts for the reasoning. Default: proportional.
FOLLOWER_MODE=fixed

# Required if FOLLOWER_MODE=proportional: your allocation, sized as a share
# of the leader's own equity (ratio = this / leader's equity).
FOLLOWER_ALLOCATION_USD=

# Required if FOLLOWER_MODE=fixed: every leader fill mirrors as this many
# dollars, same direction, regardless of leader size. Best for small
# accounts copying much larger ones.
FOLLOWER_FIXED_USD=1
